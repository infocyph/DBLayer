{
    "name": "infocyph/dblayer",
    "description": "High-performance, secure database layer for PHP and multi-driver capabilities",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "database",
        "query-builder",
        "repository",
        "pdo",
        "sql",
        "mysql",
        "postgresql",
        "sqlite",
        "mariadb",
        "sql-server",
        "mssql"
    ],
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "infocyph/arraykit": "^5.3",
        "infocyph/cachelayer": "^4.0",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/runwire": "2.1.1",
        "tomasvotruba/cognitive-complexity": "1.2.0"
    },
    "suggest": {
        "ext-pdo_mysql": "For MySQL or MariaDB database support",
        "ext-pdo_pgsql": "For PostgreSQL database support",
        "ext-pdo_sqlite": "For SQLite database support",
        "ext-pdo_sqlsrv": "For Microsoft SQL Server database support",
        "infocyph/runwire": "Optional runtime integration planned for DBLayer 6.0; development targets Runwire 2.1.1."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\DBLayer\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-drift": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
